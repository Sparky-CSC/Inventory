{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "description": {
      "type": "string",
      "description": "Description of the category"
    },
    "icon_name": {
      "type": "string",
      "description": "Lucide icon name for this category",
      "default": "Package"
    },
    "color": {
      "type": "string",
      "description": "Color for this category (hex code)",
      "default": "#6B7280"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this category is active and available for use"
    },
    "sort_order": {
      "type": "number",
      "description": "Order for displaying categories",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}
