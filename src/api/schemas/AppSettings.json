{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "appName": {
      "type": "string",
      "description": "The name of the application."
    },
    "logoUrl": {
      "type": "string",
      "description": "URL of the custom logo for the application."
    },
    "theme": {
      "type": "string",
      "description": "The selected color theme for the application.",
      "enum": [
        "classic",
        "royal-gold",
        "crimson-night",
        "forest-grove",
        "ocean-blue",
        "midnight-navy",
        "custom"
      ],
      "default": "classic"
    },
    "customTheme": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "description": "Primary color (hex)"
        },
        "primaryFocus": {
          "type": "string",
          "description": "Primary focus color (hex)"
        },
        "primaryContent": {
          "type": "string",
          "description": "Primary content color (hex)"
        },
        "secondary": {
          "type": "string",
          "description": "Secondary color (hex)"
        },
        "secondaryFocus": {
          "type": "string",
          "description": "Secondary focus color (hex)"
        },
        "secondaryContent": {
          "type": "string",
          "description": "Secondary content color (hex)"
        },
        "base100": {
          "type": "string",
          "description": "Base background color (hex)"
        },
        "base200": {
          "type": "string",
          "description": "Secondary background color (hex)"
        },
        "base300": {
          "type": "string",
          "description": "Tertiary background color (hex)"
        },
        "baseContent": {
          "type": "string",
          "description": "Base content text color (hex)"
        },
        "baseContentSecondary": {
          "type": "string",
          "description": "Secondary content text color (hex)"
        }
      },
      "description": "Custom theme color configuration"
    },
    "sidebarSubtitle": {
      "type": "string",
      "description": "Subtitle text shown in the sidebar."
    },
    "dashboardSubtitle": {
      "type": "string",
      "description": "Subtitle for the Dashboard page."
    },
    "settingsSubtitle": {
      "type": "string",
      "description": "Subtitle for the Settings page."
    },
    "administrationSubtitle": {
      "type": "string",
      "description": "Subtitle for the Administration page."
    },
    "inventorySubtitle": {
      "type": "string",
      "description": "Subtitle for the Inventory page."
    },
    "searchSubtitle": {
      "type": "string",
      "description": "Subtitle for the Search page."
    }
  },
  "required": [
    "appName"
  ]
}
