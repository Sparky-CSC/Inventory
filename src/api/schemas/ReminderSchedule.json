{
  "name": "ReminderSchedule",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "rental_order",
        "borrowed_item"
      ],
      "description": "Type of entity this reminder is for"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the rental order or borrowed item"
    },
    "reminder_type": {
      "type": "string",
      "enum": [
        "return_due",
        "overdue",
        "pickup_ready"
      ],
      "description": "Type of reminder"
    },
    "recipient_email": {
      "type": "string",
      "format": "email",
      "description": "Email address to send reminder to"
    },
    "recipient_name": {
      "type": "string",
      "description": "Name of the recipient"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this reminder should be sent"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this reminder was actually sent"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "sent",
        "failed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Status of the reminder"
    },
    "message_subject": {
      "type": "string",
      "description": "Subject line for the reminder email"
    },
    "message_body": {
      "type": "string",
      "description": "Body content for the reminder"
    },
    "days_before_due": {
      "type": "number",
      "description": "How many days before due date this reminder is scheduled"
    },
    "auto_generated": {
      "type": "boolean",
      "default": true,
      "description": "Whether this reminder was automatically generated"
    },
    "error_message": {
      "type": "string",
      "description": "Error message if sending failed"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "reminder_type",
    "recipient_email",
    "scheduled_date"
  ]
}
