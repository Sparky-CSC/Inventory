# Copy this file to ".env.local" to run the app in SHARED mode on your own
# computer (npm run dev). Leave both empty to run in "this device only" mode.
#
# On GitHub these two values are NOT read from a file: add them under
#   Settings → Secrets and variables → Actions → Variables
# with the same names (see README.md).

VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
